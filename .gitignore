# ─────────────────────────────────────────────────────────────
# Dépendances — installées par Composer / npm, jamais versionnées
# ─────────────────────────────────────────────────────────────
/vendor/
website/vendor
website/wordpress-core
website/app/themes/optelya/node_modules
website/app/themes/optelya/dist

# ─────────────────────────────────────────────────────────────
# Environnement. En local le .env est à la racine ; sur le serveur il vit dans
# shared/ et est lié dans le docroot (website/.env). shared/ porte aussi, en
# local comme sur le serveur, les plugins sous licence (ACF Pro) et les modules
# maison (mu-plugins) — voir readme/deploiement.md.
# ─────────────────────────────────────────────────────────────
/shared/
/.env
website/.env

# ─────────────────────────────────────────────────────────────
# Contenu applicatif
# Aucun plugin n'est versionné : les gratuits viennent de Composer, ceux sous
# licence de shared/plugins/ (liens).
# ─────────────────────────────────────────────────────────────
website/app/plugins
website/app/uploads/*
!website/app/uploads/.gitkeep
# Cache de page : chaque purge vide tout le dossier, un .gitkeep compris.
# Créé par bin/init.sh en local, lien vers shared/cache sur le serveur.
website/app/cache/
website/app/upgrade

# mu-plugins : seul le chargeur de Bedrock est versionné. Les modules viennent
# de Composer, dont les modules maison rapkalin-* (dépôts privés) — voir
# readme/deploiement.md.
website/app/mu-plugins/*
!website/app/mu-plugins/bedrock-autoloader.php

# ─────────────────────────────────────────────────────────────
# Environnement & secrets
# ─────────────────────────────────────────────────────────────
.env.*
!.env.example
auth.json

# Protection par mot de passe : le fichier vit dans shared/ sur le serveur,
# jamais dans le dépôt (il contient des empreintes de mots de passe).
website/.htpasswd

# ─────────────────────────────────────────────────────────────
# Logs & caches d'outillage
# ─────────────────────────────────────────────────────────────
*.log
phpunit.xml
.phpunit.result.cache
.phpunit.cache

# ─────────────────────────────────────────────────────────────
# OS / IDE
# ─────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# ─────────────────────────────────────────────────────────────
# Travaux d'avant-vente, hors code — le dépôt est PUBLIC.
# Notes internes (arbitrages, chiffrage, prospects), prototype et PDF
# d'études des éditeurs (~100 Mo, droits de Noesis Solutions) : ils restent
# sur le poste, jamais sur GitHub.
# ─────────────────────────────────────────────────────────────
/ux/
/prototype/
/INVENTAIRE-GABARITS-COMPOSANTS.md
/.claude/
