{
  "preset": "per",
  "rules": {
    "phpdoc_trim": true,
    "yoda_style": {
      "equal": false,
      "identical": false,
      "less_and_greater": false
    }
  },
  "exclude": [
    "shared/plugins",
    "website/vendor",
    "website/wordpress-core",
    "website/app/plugins",
    "website/app/languages",
    "website/app/uploads",
    "website/app/themes/optelya/dist",
    "website/app/themes/optelya/node_modules",
    "website/app/mu-plugins"
  ],
  "notPath": [
    "website/app/advanced-cache.php",
    "website/app/wp-cache-config.php"
  ]
}
